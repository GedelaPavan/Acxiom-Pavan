@model DashboardVm
@{ViewData["Title"]="Overview";var ops=Model.Opportunities;var leads=Model.Leads;var open=ops.Where(x=>x.Status=="Open").ToList();var leadGroups=leads.GroupBy(x=>x.Status).Select(g=>new{label=g.Key,value=g.Count()});var stages=Modules.Stages.Select(s=>new{label=s,value=ops.Where(x=>x.Stage==s).Sum(x=>x.Amount)});var months=Enumerable.Range(0,6).Select(i=>new DateTime(DateTime.UtcNow.Year,DateTime.UtcNow.Month,1).AddMonths(i-5)).Select(m=>new{label=m.ToString("MMM yyyy"),value=ops.Where(x=>x.Status=="Won"&&x.ClosedDate.HasValue&&x.ClosedDate.Value.Year==m.Year&&x.ClosedDate.Value.Month==m.Month).Sum(x=>x.Amount)});}
<div class="overview-page"><div class="eyebrow">Your business at a glance</div><div class="toolbar overview-toolbar"><div><h1>Sales overview</h1><p class="intro mb-0">A clear view of your relationships, pipeline and next steps.</p></div><a href="/crm/leads/new" class="btn btn-primary">+ New lead</a></div>
<form class="filters" method="get"><select name="period" class="form-select" aria-label="Period"><option value="all">All time / custom</option><option value="today">Today</option><option value="week">This week</option><option value="month">This month</option></select><input name="from" type="date" value="@Model.From?.ToString("yyyy-MM-dd")" class="form-control" aria-label="From"/><input name="to" type="date" value="@Model.To?.ToString("yyyy-MM-dd")" class="form-control" aria-label="To"/><button class="btn btn-outline-secondary">Update</button></form><p class="small text-muted">Date filters select records by creation date. Follow-ups show all pending work. Monthly sales use the selected opportunities' actual won date.</p>
<div class="metrics"><div class="metric primary"><span>OPEN PIPELINE</span><strong>₹@open.Sum(x=>x.Amount).ToString("N0")</strong><small>Weighted: ₹@open.Sum(x=>x.Amount*x.Probability/100).ToString("N0")</small></div>
@foreach(var card in new[]{("Total customers",Model.Customers.Count),("Total leads",leads.Count),("Open leads",leads.Count(x=>x.Status is "New" or "Contacted" or "Qualified")),("Total opportunities",ops.Count),("Open opportunities",open.Count),("Won opportunities",ops.Count(x=>x.Status=="Won")),("Lost opportunities",ops.Count(x=>x.Status=="Lost"))}){<div class="metric"><span>@card.Item1.ToUpperInvariant()</span><strong>@card.Item2</strong><small>Within your scope</small></div>}</div>
<div class="charts"><section class="panel chart-panel"><h2>Lead status</h2><div class="chart-box"><canvas id="lead-chart" aria-label="Lead status chart"></canvas></div><p class="chart-fallback">@string.Join(" · ",leadGroups.Select(x=>$"{x.label}: {x.value}"))</p></section><section class="panel chart-panel"><h2>Opportunity pipeline</h2><div class="chart-box"><canvas id="pipeline-chart" aria-label="Pipeline chart"></canvas></div><p class="chart-fallback">@string.Join(" · ",stages.Select(x=>$"{x.label}: ₹{x.value:N0}"))</p></section><section class="panel chart-panel"><h2>Monthly won sales</h2><div class="chart-box"><canvas id="sales-chart" aria-label="Monthly sales chart"></canvas></div><p class="chart-fallback">@string.Join(" · ",months.Select(x=>$"{x.label}: ₹{x.value:N0}"))</p></section><section class="panel chart-panel followup-panel"><h2>Upcoming & overdue</h2><p class="text-muted small">@Model.FollowUps.Count(x=>x.Status=="Planned") pending follow-ups</p>@foreach(var f in Model.FollowUps.Where(x=>x.Status=="Planned").OrderBy(x=>x.FollowUpDate).Take(7)){<div class="followup-row"><a href="/crm/followups/@f.Id">@f.Name</a><span class="@(f.FollowUpDate<DateTime.UtcNow.Date?"text-danger":"text-muted")">@f.FollowUpDate?.ToString("dd MMM")</span></div>}</section></div></div>
@section Scripts{
<script src="/vendor/chart.umd.min.js"></script><script>
if(window.Chart){const lead=@Html.Raw(JsonSerializer.Serialize(leadGroups));const pipeline=@Html.Raw(JsonSerializer.Serialize(stages));const sales=@Html.Raw(JsonSerializer.Serialize(months));function draw(id,type,data){const palette=['#ea7658','#d7eb79','#7078cc','#54aaa1','#e5b457','#d393b8'];const grid='#eeeae2';new Chart(document.getElementById(id),{type,data:{labels:data.map(x=>x.label),datasets:[{data:data.map(x=>x.value),backgroundColor:type==='line'?'rgba(234,118,88,.15)':palette,borderColor:type==='line'?'#ea7658':palette,borderWidth:type==='bar'?0:2,borderRadius:type==='bar'?7:0,pointBackgroundColor:'#ea7658',pointBorderColor:'#fff',pointBorderWidth:3,pointRadius:4,fill:type==='line',tension:.35}]},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:type==='doughnut',position:'bottom',labels:{usePointStyle:true,boxWidth:8,padding:18,color:'#6d716c',font:{family:'system-ui',size:11}}}},scales:type==='doughnut'?{}:{x:{grid:{display:false},ticks:{color:'#777b76',font:{family:'system-ui',size:11}}},y:{beginAtZero:true,grid:{color:grid},border:{display:false},ticks:{color:'#777b76',font:{family:'system-ui',size:11}}}}}});}draw('lead-chart','doughnut',lead);draw('pipeline-chart','bar',pipeline);draw('sales-chart','line',sales);}
</script>}
